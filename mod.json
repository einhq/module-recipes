{
  "name": "recipes",
  "version": "0.1.0",
  "description": "Recipes: ingredients, steps and pictures, with the ingredients scaled to the servings wanted",
  "license": "Elastic-2.0, with an added permission (LICENSE)",
  "coreApi": "^0.11.0",
  "exports": {
    "./api": "./lib/api.ts",
    "./store": "./lib/store.ts",
    "./ingredients": "./lib/ingredients.ts"
  },
  "imports": {
    "@recipes/store": "./lib/store.ts",
    "@recipes/flags": "./lib/flags.ts",
    "@recipes/ingredients": "./lib/ingredients.ts",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.16"
  },
  "roots": [
    "/archive/recipes"
  ],
  "indexes": [
    {
      "name": "recipe_source",
      "on": [
        "source.url"
      ],
      "partial": "source.url"
    },
    {
      "name": "recipe_added",
      "on": [
        "addedAt"
      ],
      "partial": "addedAt"
    }
  ],
  "nodeTypes": [
    {
      "type": "recipe",
      "label": "Recipe",
      "plural": "Recipes",
      "category": "content",
      "root": "/archive/recipes",
      "searchable": true,
      "description": "A recipe in /archive/recipes: its title, the servings it is written for, its ingredients and steps in sections, the categories it is in, the language it is written in and the page it was taken from. Its pictures are files in its pictures/ directory, one of them its cover."
    }
  ],
  "ui": {
    "routes": {
      "/recipes": "ui/pages/recipes.tsx",
      "/recipes/new": "ui/pages/new-recipe.tsx",
      "/recipes/edit": "ui/pages/edit-recipe.tsx",
      "/recipes/:name": "ui/pages/recipe.tsx"
    },
    "open": {
      "recipe": "/recipes/{name}"
    }
  }
}
